{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/og.ts": {
      "includeFiles": "{api/_assets/**,public/icons/**,node_modules/@resvg/resvg-wasm/index_bg.wasm,node_modules/harfbuzzjs/*.wasm}",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/areas/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Applebot|SkypeUriPreview|Pinterestbot|redditbot|Googlebot|bingbot|Embedly).*"
        }
      ],
      "destination": "/api/share?area=:id"
    },
    {
      "source": "/compare",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Applebot|SkypeUriPreview|Pinterestbot|redditbot|Googlebot|bingbot|Embedly).*"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/api/:path*/",
      "destination": "https://groundtrust-api.onrender.com/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://groundtrust-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
